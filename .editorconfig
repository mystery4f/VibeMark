root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

# Go is gofmt-owned: tabs for indentation, no style overrides here.
[*.go]
indent_style = tab

# Go module files are tab-indented by the go command.
[*.{mod,sum}]
indent_style = tab

[*.{c,h}]
indent_size = 4

[*.{js,jsx,ts,tsx,json,jsonc,css,scss,less,html,yml,yaml}]
indent_size = 2

# Markdown keeps trailing spaces: two of them are a hard line break.
[*.md]
indent_size = 2
trim_trailing_whitespace = false

[*.{sh,bash}]
indent_size = 2

[Makefile]
indent_style = tab
